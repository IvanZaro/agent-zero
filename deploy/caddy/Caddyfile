# Caddy config for Agent-Zero VPS. See plan §5 / §9.
#
# Stock `caddy:2-alpine` is used. The optional `rate_limit` directive (plan §9)
# requires github.com/mholt/caddy-ratelimit via xcaddy. To enable later:
#   FROM caddy:2-builder-alpine AS b
#   RUN xcaddy build --with github.com/mholt/caddy-ratelimit
#   FROM caddy:2-alpine
#   COPY --from=b /usr/bin/caddy /usr/bin/caddy
# Then add a @login matcher + rate_limit block below.
#
# Auto-HTTPS via Let's Encrypt requires:
#  - DNS A record `a0.alfredon.cloud` -> VPS public IP (Cloudflare DNS-only mode)
#  - Inbound 80/443 open on UFW (challenge response)

a0.alfredon.cloud {
    encode zstd gzip
    reverse_proxy agent-zero:80
}
