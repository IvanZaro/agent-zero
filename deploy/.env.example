# /opt/agent-zero/.env  (DO NOT commit real .env to git)
# Copy this to .env on VPS and fill in real values.
#
#   cp deploy/.env.example .env
#   nano .env
#
# See plan §9 for the full secret-management / lockout-recovery story.

# Image tag deployed by GitHub Actions SSH-deploy (rewritten on each main push).
IMAGE_TAG=latest

# Web UI basic auth (helpers/login.py).
AUTH_LOGIN=ivan
AUTH_PASSWORD=    # generate with: openssl rand -base64 24

# LLM provider keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Telegram plugin (also configurable via Settings UI; this is the ops mirror).
TELEGRAM_BOT_TOKEN=

# A0 listens on 0.0.0.0:80 inside the container; Caddy reverse-proxies.
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=80

# Shared secret between agent-zero and reindex_watcher containers, used to
# authorize POST /api/knowledge_reindex (see api/knowledge_reindex.py).
# Generate once: openssl rand -hex 32
REINDEX_SECRET=
