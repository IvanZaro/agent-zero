# Ignore common unwanted files globally
**/.DS_Store
**/.env
**/__pycache__/
*.py[cod]
**/.conda/
**/node_modules/

#Ignore IDE files
.cursor/
.windsurf/

# ignore test files in root dir
/*.test.py

# Ignore all contents of the virtual environment directory
.venv/

# obsolete folders
/memory/
/knowledge/custom/
/instruments/

# Handle logs directory
logs/**
!logs/**/

# Handle tmp and usr directory
tmp/**
!tmp/**/

# hack to keep .gitkeep but ignore nested repos
# Ignore everything under usr
usr/**
# Ignore nested repos
/usr/**/.git
# Allow git to traverse directories
!usr/**/
# Re-ignore everything again
usr/**/*
# But allow .gitkeep files
!usr/**/.gitkeep
# Track the autoresearch plugin (code + suites), but not its bytecode or runtime artifacts.
# Need to re-allow the parent directories explicitly because `usr/**/*` excludes them.
!usr/plugins/
!usr/plugins/autoresearch/
!usr/plugins/autoresearch/**
usr/plugins/autoresearch/**/__pycache__/
usr/plugins/autoresearch/**/*.pyc
# Runtime artifacts (per-run experiment outputs) stay ignored
usr/autoresearch/


# Local dev (Phase A) — never commit
.env.local
.env.local.bak
usr-dev/

# Sibling repos / unrelated projects in this folder
moon-dev-ai-agents/
moon-dev-trading-bots/

# IDE / editor
.vscode/

# Global rule to include .gitkeep files anywhere
!**/.gitkeep

# for browser-use
agent_history.gif

.agent/**
.claude/**
.coverage
