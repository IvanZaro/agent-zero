# Local dev environment for Agent-Zero on Win11
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# Web UI auth (Flask basic auth, see helpers/login.py)
AUTH_LOGIN=ivan
AUTH_PASSWORD=change-me-please

# Model API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Telegram dev bot — leave blank locally per plan §8 (one bot only, on VPS)
# TELEGRAM_BOT_TOKEN=

# Web UI bind
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=80
